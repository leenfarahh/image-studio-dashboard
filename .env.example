# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real key, password or token in here.
#
#   cp .env.example .env
#
# Every value below is read by config.py. Anything left blank falls back to the
# default shown in the comment.

# ------------------------------------------------------------------
# Data source (required)
# ------------------------------------------------------------------
# The Image Generator MCP tool's own Supabase project, and the only source of
# truth. Without both of these every build exits non-zero rather than
# publishing numbers that are not real.
TOOL_SUPABASE_URL=https://your-project.supabase.co
TOOL_SUPABASE_API_KEY=

# ------------------------------------------------------------------
# Viewer access (DASHBOARD_PASSWORD required)
# ------------------------------------------------------------------
# The dashboards name individual designers and show their work emails and
# per-person activity, so viewing is gated by HTTP Basic auth and the gate
# fails closed: with no password set, every page returns 503 rather than
# publishing staff data to anyone holding the URL. /health stays open.
DASHBOARD_USER=prezlab
DASHBOARD_PASSWORD=

# Set to 1 only for a deliberately public deployment. This publishes designer
# names and emails to anyone with the URL.
ALLOW_PUBLIC_DASHBOARDS=

# Bearer token guarding POST /refresh. Unset, that endpoint returns 503.
REFRESH_TOKEN=

# ------------------------------------------------------------------
# Reporting window
# ------------------------------------------------------------------
# First day of activity to report on, applied as a gte filter on every fetch.
# Setting it later than your first real event silently drops history rather
# than erroring. Default: 2026-08-23
LAUNCH_DATE=2026-08-23

# ------------------------------------------------------------------
# Refresh behaviour (optional)
# ------------------------------------------------------------------
# A served dashboard rebuilds when its data is older than this. A rebuild costs
# ~3s of Supabase round-trips, so this trades staleness against database load.
# Default: 120
AUTO_REFRESH_SECONDS=

# Floor between forced rebuilds, so holding the refresh button cannot turn into
# a stream of queries. Default: 10
MIN_REBUILD_INTERVAL=

# How often a served page asks whether the numbers changed. It only reloads
# when they differ, so this can be frequent. Default: 30
POLL_SECONDS=

# ------------------------------------------------------------------
# Retry detection (optional)
# ------------------------------------------------------------------
# The MCP client gives up on a slow generation and calls the tool again, so one
# picture can land as several successful-looking rows. An attempt counts as
# superseded when the same person re-renders an identical prompt on the same
# model within RETRY_WINDOW_SECONDS and that attempt ran at or past
# CLIENT_TIMEOUT_MS. Raise CLIENT_TIMEOUT_MS if the tool's own timeout is
# raised. Defaults: 300 and 75000
RETRY_WINDOW_SECONDS=
CLIENT_TIMEOUT_MS=

# ------------------------------------------------------------------
# Local dev only
# ------------------------------------------------------------------
# Port for `python app.py`. Default: 8080
# Never set this on Render: the platform assigns and injects PORT, and
# overriding it makes gunicorn bind a port the health check is not probing.
PORT=8080

# On Render, set these in the dashboard rather than in a file, and add
# PYTHON_VERSION=3.12.10 as well: Render ignores runtime.txt and otherwise
# picks its own default. See render.yaml.
